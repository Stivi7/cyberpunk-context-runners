#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATES_DIR="$SCRIPT_DIR/templates"
VERSION="0.3.0"

DRY_RUN=false
FORCE=false
REQUESTED_RUNTIMES=()

source "$SCRIPT_DIR/lib/config.bash"
source "$SCRIPT_DIR/lib/generated-assets.bash"

REQUIRED_FILES=(
    ".cyberpunk/config.yml"
    ".cyberpunk/project.md"
    ".cyberpunk/workflow.md"
    ".cyberpunk/memory/decisions.md"
    ".cyberpunk/memory/patterns.md"
    ".cyberpunk/memory/lessons.md"
    "agents/_common-principles.md"
    "agents/nexus.md"
    "agents/fixer.md"
    "agents/operator.md"
    "agents/mind.md"
    "agents/interrogator.md"
    "agents/fragmenter.md"
    "agents/coder.md"
    "agents/daemon.md"
    "agents/neon.md"
    "agents/grid-master.md"
    "agents/gatekeeper.md"
    "skills/README.md"
    "skills/core/requirements-discovery/SKILL.md"
    "skills/core/worktree-isolation/SKILL.md"
)

log_info() {
    echo "[INFO] $1"
}

log_success() {
    echo "[SUCCESS] $1"
}

log_warning() {
    echo "[WARNING] $1"
}

log_error() {
    echo "[ERROR] $1" >&2
}

show_usage() {
    cat <<EOF
Cyberpunk CLI v$VERSION

USAGE:
    cyberpunk init [--runtime codex|claude|cursor|all]... [--dry-run] [--force]
    cyberpunk sync [--dry-run] [--force]
    cyberpunk validate
    cyberpunk status
    cyberpunk --help
    cyberpunk --version

COMMANDS:
    init        Scaffold the runtime-neutral engineering team
    validate    Check the generated team and project contracts
    status      Report project, agent, skill, and local-run state

INIT OPTIONS:
    --runtime    Select a runtime; may be specified more than once
    --dry-run   Preview operations without writing files
    --force     Refresh framework-owned template files
EOF
}

show_version() {
    echo "Cyberpunk CLI v$VERSION"
}

validate_templates() {
    if [[ ! -d "$TEMPLATES_DIR" ]]; then
        log_error "Templates directory not found: $TEMPLATES_DIR"
        return 1
    fi
}

create_directory() {
    local path="$1"

    if [[ -d "$path" ]]; then
        return 0
    fi

    if [[ "$DRY_RUN" == true ]]; then
        log_info "[DRY-RUN] Would create directory: $path"
        return 0
    fi

    mkdir -p "$path"
    log_success "Created directory: $path"
}

copy_template_file() {
    local source="$1"
    local destination="$2"
    local destination_dir
    destination_dir="$(dirname "$destination")"

    create_directory "$destination_dir"

    if [[ -f "$destination" && "$FORCE" != true ]]; then
        if [[ "$DRY_RUN" == true ]]; then
            log_warning "[DRY-RUN] Would preserve existing file: $destination"
        else
            log_warning "Preserved existing file: $destination"
        fi
        return 0
    fi

    if [[ "$DRY_RUN" == true ]]; then
        if [[ -f "$destination" ]]; then
            log_info "[DRY-RUN] Would refresh: $destination"
        else
            log_info "[DRY-RUN] Would copy: $destination"
        fi
        return 0
    fi

    cp "$source" "$destination"
    log_success "Copied: $destination"
}

copy_template_tree() {
    local source
    local relative
    local destination
    local file_count=0

    while IFS= read -r -d '' source; do
        relative="${source#$TEMPLATES_DIR/}"
        destination="./$relative"

        if [[ -d "$source" ]]; then
            create_directory "$destination"
        elif [[ -f "$source" ]]; then
            case "$relative" in
                AGENTS.md|CLAUDE.md|.cursor/rules/rules.mdc|.cursor/rules/cyberpunk.mdc|.codex/config.toml|.cyberpunk/generated.yml|.codex/agents/*|.claude/agents/*|.cursor/agents/*|.agents/skills/*|.claude/skills/*|.cursor/skills/*)
                    continue
                    ;;
            esac
            copy_template_file "$source" "$destination"
            file_count=$((file_count + 1))
        fi
    done < <(find "$TEMPLATES_DIR" -mindepth 1 -print0)

    log_info "Processed $file_count template files"
}

ensure_local_state() {
    create_directory ".cyberpunk/runs"
}

ignore_entry_exists() {
    local entry="$1"
    local ignore_file="$2"
    [[ -f "$ignore_file" ]] && grep -Fqx "$entry" "$ignore_file"
}

configured_worktree_ignore() {
    local root=".worktrees"
    local configured=""

    if [[ -f ".cyberpunk/config.yml" ]]; then
        configured="$(sed -n 's/^[[:space:]]*worktree_root:[[:space:]]*//p' .cyberpunk/config.yml | head -n 1)"
        configured="${configured#\"}"
        configured="${configured%\"}"
        [[ -n "$configured" ]] && root="$configured"
    fi

    printf '%s/\n' "${root%/}"
}

ensure_ignore_entries() {
    local ignore_file=".gitignore"
    local entry
    local missing_count=0
    local entries=(
        ".cyberpunk/runs/"
        "$(configured_worktree_ignore)"
    )

    for entry in "${entries[@]}"; do
        if ! ignore_entry_exists "$entry" "$ignore_file"; then
            missing_count=$((missing_count + 1))
            if [[ "$DRY_RUN" == true ]]; then
                log_info "[DRY-RUN] Would add to $ignore_file: $entry"
            elif [[ ! -f "$ignore_file" ]]; then
                printf '%s\n' "$entry" > "$ignore_file"
                log_success "Created $ignore_file with: $entry"
            else
                printf '\n%s\n' "$entry" >> "$ignore_file"
                log_success "Added to $ignore_file: $entry"
            fi
        fi
    done

    if [[ "$missing_count" -eq 0 ]]; then
        log_info "Required ignore entries already exist"
    fi
}

init_project() {
    local existing_config=false

    [[ -f ".cyberpunk/config.yml" ]] && existing_config=true
    validate_templates

    if [[ "$DRY_RUN" == true ]]; then
        log_info "=== DRY RUN - NO FILES WILL BE WRITTEN ==="
    fi

    copy_template_tree
    if [[ -f ".cyberpunk/config.yml" ]]; then
        migrate_config_v1 ".cyberpunk/config.yml"
        if [[ ${#REQUESTED_RUNTIMES[@]} -gt 0 ]]; then
            if [[ "$existing_config" == true ]]; then
                merge_configured_runtimes ".cyberpunk/config.yml" "${REQUESTED_RUNTIMES[@]}"
            else
                write_configured_runtimes ".cyberpunk/config.yml" "${REQUESTED_RUNTIMES[@]}"
            fi
        else
            merge_configured_runtimes ".cyberpunk/config.yml" all
        fi
        sync_project
    fi
    ensure_local_state
    ensure_ignore_entries

    if [[ "$DRY_RUN" == true ]]; then
        log_info "=== END DRY RUN ==="
    else
        log_success "Cyberpunk engineering team initialized"
        log_info "Next: ask The Nexus to inspect the project and take a task"
    fi
}

sync_project() {
    local runtime
    local cursor_content=""

    migrate_config_v1 ".cyberpunk/config.yml"
    begin_generated_manifest ".cyberpunk/generated.yml"

    while IFS= read -r runtime; do
        [[ -n "$runtime" ]] || continue
        case "$runtime" in
            codex)
                if ! update_managed_block "AGENTS.md" "$TEMPLATES_DIR/AGENTS.md"; then
                    cleanup_generated_manifest
                    return 1
                fi
                if ! ensure_codex_agent_settings ".codex/config.toml"; then
                    cleanup_generated_manifest
                    return 1
                fi
                ;;
            claude)
                if ! update_managed_block "CLAUDE.md" "$TEMPLATES_DIR/CLAUDE.md"; then
                    cleanup_generated_manifest
                    return 1
                fi
                ;;
            cursor)
                cursor_content="$GENERATED_MANIFEST_WORKDIR/cursor.mdc"
                if ! cat > "$cursor_content" <<'EOF'
<!-- Generated by Cyberpunk. Canonical source is recorded in .cyberpunk/generated.yml. -->
---
description: Route project tasks through the runtime-neutral Cyberpunk engineering team
globs:
alwaysApply: true
---

# Cyberpunk Engineering Team Adapter

Read `.cyberpunk/workflow.md` completely, act as Nexus in the parent session,
and use Cursor's native Cyberpunk agents and skills. Dispatch dependency-ready
independent work in parallel up to project policy limits.
EOF
                then
                    cleanup_generated_manifest
                    return 1
                fi
                if ! write_generated_asset ".cursor/rules/cyberpunk.mdc" ".cyberpunk/workflow.md" "cursor" "adapter" "cyberpunk" "$cursor_content"; then
                    cleanup_generated_manifest
                    return 1
                fi
                if ! rm -f "$cursor_content"; then
                    cleanup_generated_manifest
                    return 1
                fi
                ;;
        esac
    done < <(configured_runtimes ".cyberpunk/config.yml")

    finish_generated_manifest
}

validate_skill_frontmatter() {
    local path="$1"
    local content
    content="$(sed -n '1,/^---$/p' "$path" 2>/dev/null || true)"

    [[ "$content" == *"name:"* && "$content" == *"description:"* ]]
}

validate_project() {
    local error_count=0
    local path
    local entry
    local skill_path
    local required_policy
    local ignore_entries=(
        ".cyberpunk/runs/"
        "$(configured_worktree_ignore)"
    )
    local required_policies=(
        "  default: integration-branch"
        "  allow_push: false"
        "  allow_pull_requests: false"
        "  allow_deploy: false"
        "  require_worktrees: true"
        "  allow_internal_commits: true"
        "  merge_worker_branches: true"
        "  allow_protected_branch_merge: false"
    )

    for path in "${REQUIRED_FILES[@]}"; do
        if [[ ! -f "$path" ]]; then
            log_error "Missing required file: $path"
            error_count=$((error_count + 1))
        fi
    done

    if [[ ! -d ".cyberpunk/runs" ]]; then
        log_error "Missing local run directory: .cyberpunk/runs"
        error_count=$((error_count + 1))
    fi

    for entry in "${ignore_entries[@]}"; do
        if ! ignore_entry_exists "$entry" ".gitignore"; then
            log_error "Missing .gitignore entry: $entry"
            error_count=$((error_count + 1))
        fi
    done

    if [[ -f ".cyberpunk/config.yml" ]]; then
        for required_policy in "${required_policies[@]}"; do
            if ! grep -Fqx "$required_policy" .cyberpunk/config.yml; then
                if [[ "$required_policy" == *"allow_protected_branch_merge"* ]]; then
                    log_error "Unsafe or missing protected branch policy: $required_policy"
                else
                    log_error "Unsafe or missing team policy: $required_policy"
                fi
                error_count=$((error_count + 1))
            fi
        done
    fi

    if [[ -d "skills/core" ]]; then
        while IFS= read -r skill_path; do
            if ! validate_skill_frontmatter "$skill_path"; then
                log_error "Invalid skill frontmatter: $skill_path"
                error_count=$((error_count + 1))
            fi
        done < <(find "skills/core" -mindepth 2 -maxdepth 2 -name SKILL.md -type f | sort)
    fi

    if [[ "$error_count" -gt 0 ]]; then
        log_error "Validation failed with $error_count issue(s)"
        return 1
    fi

    log_success "Validation passed"
}

count_files() {
    local directory="$1"
    local pattern="$2"

    if [[ ! -d "$directory" ]]; then
        echo 0
        return 0
    fi

    find "$directory" -type f -name "$pattern" | wc -l | tr -d ' '
}

status_project() {
    local status="not initialized"
    local agent_count=0
    local core_skill_count=0
    local project_skill_count=0
    local run_count=0
    local discovery="unavailable"

    if [[ -f ".cyberpunk/workflow.md" && -f "agents/nexus.md" ]]; then
        status="initialized"
    fi

    if [[ -d "agents" ]]; then
        agent_count="$(find agents -maxdepth 1 -type f -name '*.md' ! -name '_*' | wc -l | tr -d ' ')"
    fi
    core_skill_count="$(count_files "skills/core" "SKILL.md")"
    project_skill_count="$(count_files "skills/project" "SKILL.md")"
    if [[ -d ".cyberpunk/runs" ]]; then
        run_count="$(find .cyberpunk/runs -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')"
    fi
    if [[ -f ".cyberpunk/project.md" ]]; then
        discovery="$(sed -n 's/^\*\*Discovery status:\*\* //p' .cyberpunk/project.md | head -n 1)"
        [[ -n "$discovery" ]] || discovery="unknown"
    fi

    echo "Status: $status"
    echo "Project discovery: $discovery"
    echo "Agents: $agent_count"
    echo "Core skills: $core_skill_count"
    echo "Project skills: $project_skill_count"
    echo "Active local runs: $run_count"
}

reset_options() {
    DRY_RUN=false
    FORCE=false
    REQUESTED_RUNTIMES=()
}

parse_command_options() {
    local command="$1"
    local allow_runtime="$2"
    shift 2

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                DRY_RUN=true
                ;;
            --force)
                FORCE=true
                ;;
            --runtime)
                if [[ "$allow_runtime" != true ]]; then
                    log_error "$command does not accept --runtime"
                    show_usage
                    exit 1
                fi
                if [[ $# -lt 2 || -z "$2" ]]; then
                    log_error "--runtime requires a value"
                    show_usage
                    exit 1
                fi
                REQUESTED_RUNTIMES+=("$2")
                shift
                ;;
            -h|--help)
                show_usage
                exit 0
                ;;
            *)
                log_error "Unknown $command option: $1"
                show_usage
                exit 1
                ;;
        esac
        shift
    done

    if [[ "$allow_runtime" == true ]]; then
        if [[ ${#REQUESTED_RUNTIMES[@]} -gt 0 ]]; then
            normalize_runtime_selection "${REQUESTED_RUNTIMES[@]}" >/dev/null
        else
            normalize_runtime_selection >/dev/null
        fi
    fi
}

require_no_arguments() {
    local command="$1"
    shift
    if [[ $# -gt 0 ]]; then
        log_error "$command does not accept options"
        exit 1
    fi
}

main() {
    reset_options

    if [[ $# -eq 0 ]]; then
        show_usage
        exit 1
    fi

    case "$1" in
        init)
            shift
            parse_command_options init true "$@"
            init_project
            ;;
        sync)
            shift
            parse_command_options sync false "$@"
            sync_project
            ;;
        validate)
            shift
            require_no_arguments validate "$@"
            validate_project
            ;;
        status)
            shift
            require_no_arguments status "$@"
            status_project
            ;;
        -h|--help)
            shift
            require_no_arguments help "$@"
            show_usage
            ;;
        -v|--version)
            shift
            require_no_arguments version "$@"
            show_version
            ;;
        *)
            log_error "Unknown command: $1"
            show_usage
            exit 1
            ;;
    esac
}

main "$@"
